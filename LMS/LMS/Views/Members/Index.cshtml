@model IEnumerable<Member>
@{ViewData["Title"]="Members";}
<div class="page-heading">
    <div>
        <h1>
            Members
        </h1>
        <p>
            Manage university library members
        </p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
    <i class="bi bi-person-plus">
    </i>
    Add Member
    </a>
</div>
<form class="search-bar mb-3">
    <div class="input-group">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search code, name, department or email">
        <button class="btn btn-primary">
        <i class="bi bi-search">
        </i>
        Search
        </button>
    </div>
</form>
<div class="card page-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>
                    Member Code
                    </th>
                    <th>
                    Name
                    </th>
                    <th>
                    Department
                    </th>
                    <th>
                    Phone
                    </th>
                    <th>
                    Email
                    </th>
                    <th>
                    Join Date
                    </th>
                    <th>
                    Status
                    </th>
                    <th>
                    Actions
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model) {
                    <tr>
                        <td>
                        @x.MemberCode
                        </td>
                        <td class="fw-semibold">
                        @x.Name
                        </td>
                        <td>
                        @x.Department
                        </td>
                        <td>
                        @x.Phone
                        </td>
                        <td>
                        @x.Email
                        </td>
                        <td>
                        @x.JoinDate.ToString("dd MMM yyyy")
                        </td>
                        <td>
                        <span class="badge text-bg-@(x.IsActive?"success":"secondary")">
                        @(x.IsActive?"Active":"Inactive")
                        </span>
                        </td>
                        <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-light">
                        <i class="bi bi-eye">
                        </i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-light">
                        <i class="bi bi-pencil">
                        </i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@x.Id" class="btn btn-sm btn-light text-danger">
                        <i class="bi bi-trash">
                        </i>
                        </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
