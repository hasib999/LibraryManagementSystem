@model Member
@{ViewData["Title"]="Delete Member";}
<div class="page-heading">
    <h1>
        Delete Member
    </h1>
</div>
<div class="card page-card">
    <div class="card-body">
        <h2 class="h5">
            Remove “@Model.Name”?
        </h2>
        <p class="text-muted">
            Members with issue history will be deactivated instead of permanently deleted.
        </p>
        <form method="post">
            <input type="hidden" asp-for="Id">
            <button class="btn btn-danger">
            Confirm
            </button>
            <a asp-action="Index" class="btn btn-light">
            Cancel
            </a>
        </form>
    </div>
</div>
