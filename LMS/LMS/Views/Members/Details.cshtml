@model Member
@{ViewData["Title"]="Member Details";}<div class="page-heading"><h1>Member Details</h1></div><div class="card page-card"><div class="card-body"><dl class="row details-list"><dt class="col-sm-3">Member Code</dt><dd class="col-sm-9">@Model.MemberCode</dd><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Department</dt><dd class="col-sm-9">@Model.Department</dd><dt class="col-sm-3">Contact</dt><dd class="col-sm-9">@Model.Phone · @Model.Email</dd><dt class="col-sm-3">Join Date</dt><dd class="col-sm-9">@Model.JoinDate.ToString("dd MMM yyyy")</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.IsActive?"Active":"Inactive")</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a> <a asp-action="Index" class="btn btn-light">Back</a></div></div>
