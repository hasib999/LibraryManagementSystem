@model Book
@{ViewData["Title"]="Book Details";}<div class="page-heading"><h1>Book Details</h1></div><div class="card page-card"><div class="card-body"><dl class="row details-list"><dt class="col-sm-3">ISBN</dt><dd class="col-sm-9">@Model.ISBN</dd><dt class="col-sm-3">Title</dt><dd class="col-sm-9">@Model.Title</dd><dt class="col-sm-3">Author</dt><dd class="col-sm-9">@Model.Author</dd><dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.Category</dd><dt class="col-sm-3">Publisher / Year</dt><dd class="col-sm-9">@Model.Publisher, @Model.PublicationYear</dd><dt class="col-sm-3">Copies</dt><dd class="col-sm-9">@Model.AvailableQuantity available of @Model.Quantity</dd><dt class="col-sm-3">Shelf</dt><dd class="col-sm-9">@Model.ShelfNumber</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a> <a asp-action="Index" class="btn btn-light">Back</a></div></div>
