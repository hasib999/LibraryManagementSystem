@model IEnumerable<BookIssue>
@{ViewData["Title"]="Return Book";var today=DateTime.Today;}
<div class="page-heading">
    <div>
        <h1>
            Return Book
        </h1>
        <p>
            BDT 10 fine per late day
        </p>
    </div>
</div>
<div class="card page-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>
                    Issue ID
                    </th>
                    <th>
                    Book
                    </th>
                    <th>
                    Member
                    </th>
                    <th>
                    Issue Date
                    </th>
                    <th>
                    Due Date
                    </th>
                    <th>
                    Late Days
                    </th>
                    <th>
                    Fine
                    </th>
                    <th>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model) {
                    var late=Math.Max(0,(today-x.DueDate.Date).Days);
                    <tr>
                        <td>
                        #@x.Id
                        </td>
                        <td>
                        @x.Book.Title
                        </td>
                        <td>
                        @x.Member.Name
                        </td>
                        <td>
                        @x.IssueDate.ToString("dd MMM yyyy")
                        </td>
                        <td>
                        @x.DueDate.ToString("dd MMM yyyy")
                        </td>
                        <td>
                        @late
                        </td>
                        <td>
                        BDT @(late*10)
                        </td>
                        <td>
                        <a asp-action="Create" asp-route-id="@x.Id" class="btn btn-sm btn-success">
                        Return
                        </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                        No books are currently issued.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
