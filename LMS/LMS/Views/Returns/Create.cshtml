@model ReturnBookViewModel
@{ViewData["Title"]="Confirm Return";BookIssue issue=ViewBag.Issue;}<div class="page-heading"><h1>Confirm Return</h1></div><div class="card page-card"><div class="card-body"><p><strong>Book:</strong> @issue.Book.Title</p><p><strong>Member:</strong> @issue.Member.Name</p><p><strong>Due:</strong> @issue.DueDate.ToString("dd MMM yyyy")</p><form method="post"><input type="hidden" asp-for="BookIssueId"><div class="mb-3"><label asp-for="ReturnDate" class="form-label"></label><input asp-for="ReturnDate" class="form-control"><span asp-validation-for="ReturnDate" class="text-danger"></span></div><button class="btn btn-success">Confirm Return</button> <a asp-action="Index" class="btn btn-light">Cancel</a></form></div></div><partial name="_ValidationScriptsPartial"/>
