@model IssueBookViewModel
@{ViewData["Title"]="Issue Book";}<div class="page-heading"><div><h1>Issue Book</h1><p>Assign an available book to an active member</p></div></div><div class="card page-card"><div class="card-body"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="MemberId" class="form-label"></label><select asp-for="MemberId" asp-items="Model.Members" class="form-select"><option value="">Select member</option></select><span asp-validation-for="MemberId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="BookId" class="form-label"></label><select asp-for="BookId" asp-items="Model.Books" class="form-select"><option value="">Select book</option></select><span asp-validation-for="BookId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="IssueDate" class="form-label"></label><input asp-for="IssueDate" class="form-control"></div><div class="col-md-6"><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" class="form-control"><span asp-validation-for="DueDate" class="text-danger"></span></div></div><div class="mt-4"><button class="btn btn-primary">Issue Book</button> <a asp-action="Index" class="btn btn-light">Cancel</a></div></form></div></div><partial name="_ValidationScriptsPartial"/>
