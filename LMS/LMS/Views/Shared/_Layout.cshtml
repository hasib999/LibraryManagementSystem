@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{ var appUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] - Library Management System</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"></head>
<body><nav class="navbar navbar-dark bg-dark fixed-top"><div class="container-fluid"><button class="navbar-toggler d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#sidebar"><span class="navbar-toggler-icon"></span></button><a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index"><i class="bi bi-book-half me-2"></i>Library Management System</a><span class="text-white small d-none d-sm-inline"><i class="bi bi-person-circle me-1"></i>@(appUser?.FullName ?? User.Identity?.Name)</span></div></nav>
<div class="offcanvas-lg offcanvas-start sidebar" tabindex="-1" id="sidebar"><div class="offcanvas-header"><h5>Navigation</h5><button class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebar"></button></div><div class="offcanvas-body d-flex flex-column p-3"><nav class="nav nav-pills flex-column gap-1"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-grid"></i>Dashboard</a><a class="nav-link" asp-controller="Books"><i class="bi bi-book"></i>Books</a><a class="nav-link" asp-controller="Members"><i class="bi bi-people"></i>Members</a><a class="nav-link" asp-controller="Issues" asp-action="Create"><i class="bi bi-box-arrow-up-right"></i>Issue Book</a><a class="nav-link" asp-controller="Returns"><i class="bi bi-box-arrow-in-down-left"></i>Return Book</a><a class="nav-link" asp-controller="Issues"><i class="bi bi-clock-history"></i>Transactions</a><a class="nav-link" asp-controller="Reports"><i class="bi bi-bar-chart"></i>Reports</a></nav><form class="mt-auto" asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light w-100"><i class="bi bi-box-arrow-right me-2"></i>Logout</button></form></div></div>
<main class="main-content"><partial name="_Alert"/>@RenderBody()<footer class="mt-5 pt-3 border-top text-muted small">Library Management System <span class="mx-2">•</span> University Database Project</footer></main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
